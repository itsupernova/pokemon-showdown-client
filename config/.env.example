# Database Configuration for PostgreSQL (Render + Supabase)
# Copy this to .env and fill in your actual values

# Main database configuration
DB_DRIVER=pgsql
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_password
DB_NAME=postgres
DB_PREFIX=ps_
DB_SSLMODE=require

# Alternative: Use single DATABASE_URL connection string
# DATABASE_URL=postgresql://user:password@host:5432/database

# Replay database configuration (can be same as main DB)
# Leave blank to use main database settings
REPLAY_DB_DRIVER=pgsql
REPLAY_DB_HOST=your-supabase-host.supabase.co
REPLAY_DB_PORT=5432
REPLAY_DB_USER=postgres
REPLAY_DB_PASSWORD=your_supabase_password
REPLAY_DB_NAME=replays
REPLAY_DB_PREFIX=ps_
REPLAY_DB_SSLMODE=require

# Alternative: Use single REPLAY_DATABASE_URL connection string
# REPLAY_DATABASE_URL=postgresql://user:password@host:5432/replays

# Application settings
PS_SYSOPS=zarel
PS_PASSWORD_COST=12
PS_SID_LENGTH=15
PS_SID_COST=4

# Optional: Private key for SSO
# PS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
