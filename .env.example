# Pokemon Showdown Client - Environment Variables
# Copy this to .env and fill in your values for local development

# Database Configuration for PostgreSQL
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=pokemonshowdown
DB_PREFIX=ps_
DB_SSLMODE=prefer

# For production with Supabase on Render:
# DB_HOST=your-project.supabase.co
# DB_SSLMODE=require

# Alternative: Single connection string URL
# DATABASE_URL=postgresql://user:password@localhost:5432/pokemonshowdown

# Replay database (can be same as main DB or different)
REPLAY_DB_HOST=localhost
REPLAY_DB_PORT=5432
REPLAY_DB_USER=postgres
REPLAY_DB_PASSWORD=your_password
REPLAY_DB_NAME=replays
REPLAY_DB_PREFIX=ps_

# Application configuration
PS_SYSOPS=zarel,admin
PS_PASSWORD_COST=12
PS_SID_LENGTH=15
PS_SID_COST=4
